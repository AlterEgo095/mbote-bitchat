# ─────────────────────────────────────────────────────────────────────────────
# Mbote BitChat — variables d'environnement (modèle à copier en `.env`)
# Références audit : F-02 (SEED_SECRET), F-09 (NEXT_PUBLIC_SOCKET_URL),
# F-29 (MBOTE_BOT_KEY), F-50/F-51 (RELAY_EMIT_TOKEN).
# ⚠️ Ne JAMAIS committer le vrai .env — chaque valeur ci-dessous est un exemple.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
# SQLite (Prisma). En Docker compose : file:/app/db/custom.db (volume mbote-data).
DATABASE_URL="file:./db/custom.db"

# ── Web / build ──────────────────────────────────────────────────────────────
# URL PUBLIQUE du hub temps réel, vue par le navigateur (ex. https://mbote.exemple.tld).
# CRITIQUE : doit être définie AU MOMENT DU BUILD (inlinée dans le bundle client) — F-09.
# Vide = même origine via la passerelle (?XTransformPort=3030, mode sandbox uniquement).
NEXT_PUBLIC_SOCKET_URL=""

# Environnement Next : production en VPS (désactive le hub embarqué, active
# la CSP sans 'unsafe-eval').
NODE_ENV="development"

# ── Hub temps réel (mini-services/relay-service) ────────────────────────────
# URL interne d'émission utilisée par les routes API Next (relay-notify).
# Sandbox/hôte unique : http://127.0.0.1:3031 · Docker compose : http://relay:3031
RELAY_EMIT_URL="http://127.0.0.1:3031"

# F-51 : token partagé pour l'endpoint interne /emit du relay.
# Défini des DEUX côtés (Next + relay). Générer : openssl rand -hex 32
RELAY_EMIT_TOKEN=""

# F-08 : origines croisées autorisées par le hub (liste à virgules).
# Vide = aucune (recommandé : le navigateur passe par la même origine).
RELAY_ALLOWED_ORIGIN=""

# Port du hub socket.io public (défaut 3030) et de l'endpoint interne (3031).
RELAY_PORT="3030"
EMIT_PORT="3031"

# F-51 (Vague 6) : bind de l'endpoint interne /emit.
# 0.0.0.0 = réseau Docker interne (défaut compose) · 127.0.0.1 = hôte unique.
RELAY_EMIT_HOST="0.0.0.0"

# ── Garde-fous applicatifs ───────────────────────────────────────────────────
# F-02 : protège POST /api/seed en production (header x-seed-secret).
# Générer : openssl rand -hex 24
SEED_SECRET=""

# F-29 : clé de chiffrement au repos du secret du bot (AES-GCM 256).
# SANS elle, le secret du bot reste en clair dans la table Identity.
# Générer : openssl rand -hex 32
MBOTE_BOT_KEY=""
