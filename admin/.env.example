# URL interne de l'app principale — réseau Docker en prod (nom du service compose),
# localhost en dev sandbox. JAMAIS exposée publiquement.
BACKEND_INTERNAL_URL=http://mbote:3000

# Token interne mbote↔admin (ADM Étape 4 — RBAC §8) : 32 octets hex, MÊME
# valeur que le service `mbote` (interpolée par le compose depuis le .env VPS).
# Identifie le panneau collectivement — JAMAIS un acteur. Jamais en DB, jamais
# en réponse HTTP, jamais loggué.
ADMIN_INTERNAL_TOKEN=hex-64-chars

# Le port 3001 est fixé par le compose et le Dockerfile (PORT=3001).
# Le conteneur ne doit être publié que sur 127.0.0.1:3001 (voir docker-compose.yml).
