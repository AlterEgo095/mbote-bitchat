{
  "expo": {
    "name": "Mbote Mesh",
    "slug": "mbote-bitchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0f0d",
    "icon": "./assets/icon.png",
    "scheme": "mbote",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0d"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "org.mbote.bitchat",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Mbote BitChat utilise le Bluetooth pour échanger des messages chiffrés avec les téléphones voisins, sans internet.",
        "NSBluetoothPeripheralUsageDescription": "Mbote BitChat utilise le Bluetooth pour échanger des messages chiffrés avec les téléphones voisins, sans internet.",
        "UIBackgroundModes": ["bluetooth-central", "bluetooth-peripheral"]
      }
    },
    "android": {
      "package": "org.mbote.bitchat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f0d"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
