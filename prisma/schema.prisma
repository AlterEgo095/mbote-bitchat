generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Identité = paire de clés locale. Pas d'email, pas de téléphone.
model User {
  id         String   @id @default(cuid())
  pubkey     String   @unique // empreinte publique (ECDSA P-256, base64url) = identité stable
  nickname   String
  bio        String?
  ecdhPub    String? // clé publique ECDH P-256 (base64url) pour le chiffrement des DM
  isBot      Boolean  @default(false)
  botPriv    String? // JWK privée — UNIQUEMENT pour le bot de démonstration
  // A3 (recadrage) — suspension par modération : posts absents du fil public,
  // publication refusée (403) tant que la suspension tient.
  suspendedAt DateTime?
  suspendedBy String? // identité admin ayant suspendu
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  posts     Post[]
  likes     Like[]
  followers Follow[] @relation("following")
  following Follow[] @relation("follower")
}

// Événement public signé côté client (style Nostr kind:1)
model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  geohash   String? // canal géographique (bloc #dr5rsj7 …)
  precision Int? // précision géohash 2..7
  parentId  String? // réponse à un autre post
  parent    Post?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]   @relation("Replies")
  signature String? @unique // signature ECDSA produite sur l'appareil (idempotence : même événement = même post)
  origin    String   @default("web") // web | mesh (arrivé via passerelle BitChat)
  meshHops  Int      @default(0) // sauts mesh traversés (7 − TTL restant)
  // Compteurs dénormalisés (scalabilité D5) : incrémentés atomiquement à l'écriture,
  // les COUNT à chaud disparaissent des lectures de feed.
  likeCount  Int      @default(0)
  replyCount Int      @default(0)
  // A3 (recadrage) — modération du fil public : masqué = absent du fil public,
  // MAIS CONSERVÉ EN DB pour audit (contrairement à la purge qui supprime).
  hiddenAt DateTime?
  hiddenBy String? // identité admin ayant masqué (clé API provisoire avant RBAC)
  createdAt  DateTime @default(now())

  likes Like[]

  @@index([geohash, precision])
  @@index([authorId])
  @@index([parentId])
  @@index([parentId, createdAt]) // scope "replies" : filtre + tri en un seul index
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// Paquets BitChat déjà ingérés par la passerelle VPS (dédup persistante)
model MeshIngest {
  hash      String   @id // SHA-256 hex du paquet brut (F-30 — l'ancien FNV-64 forgeable a été remplacé)
  gatewayId String? // senderID hex du nœud passerelle qui l'a déposé
  type      Int // type de paquet (0x01 announce, 0x02 public, 0x03 DM, 0x04 gossip)
  hops      Int // sauts mesh traversés (TTL_MAX − TTL restant)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A1 (recadrage) — garde anti-rejeu PERSISTANTE : l'empreinte couvre le tuple
// d'identité du DM (expéditeur|destinataire|iv|ciphertext), pas ses octets de
// transport. Un rejeu réemballé (nouveau paquet mesh, nouveaux msgId/seq forgés)
// reste un doublon. TTL 7 j = fenêtre de fraîcheur des preuves (ACTION_MAX_AGE_MS).
model ReplayGuard {
  id        String   @id // SHA-256 hex du tuple canonique (64 chars)
  kind      String   @default("dm") // réservé aux extensions futures (média, groupe)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// A1 — compteur de séquence monotone par (conversation, époque). Seconde
// barrière indépendante de la garde : un message v2 (msgId+seq signés) dont
// la séquence régresse est rejeté même si la garde a été purgée.
model ReplayCounter {
  key          String   @id // SHA-256 hex de `${senderKey}|${recipientKey}|${epoch}`
  senderKey    String
  recipientKey String
  epoch        BigInt // floor(tsNormalisé / REPLAY_EPOCH_MS)
  lastSeq      BigInt
  updatedAt    DateTime @updatedAt

  @@index([senderKey, recipientKey])
  @@index([epoch])
}

// A2 (recadrage) — épinglage de clés de chiffrement (authentification des clés,
// lacune L-3 de la crypto spec). Le serveur enregistre l'état de confiance
// POUR AUDIT ET DÉTECTION DE CHANGEMENT : quand l'ecdhPub servi diverge du
// dernier épinglé, la ligne passe en `changed` (alerte rouge côté client).
// L'épinglage local côté appareil (trust-client.ts) reste la barrière
// indépendante du serveur — contre un serveur pleinement malveillant, la
// comparaison hors-bande du numéro de sécurité reste l'ultime référence.
model TrustedKey {
  id            String    @id @default(cuid())
  ownerKey      String // pubkey ECDSA de l'identité locale (celle qui épingle)
  peerKey       String // pubkey ECDSA du pair (identité stable)
  ecdhPubPinned String // clé ECDH épinglée au moment du contact/vérification
  safetyNumber  String // 60 chiffres calculés sur les clés des DEUX parties
  state         String    @default("unverified") // unverified | verified | changed
  firstSeenAt   DateTime  @default(now())
  verifiedAt    DateTime?
  changedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([ownerKey, peerKey])
  @@index([ownerKey])
}

// A3 (recadrage) — signalement d'un contenu PUBLIC (posts/commentaires) vers la
// file de modération. PÉRIMÈTRE STRICT : fil public uniquement. AUCUNE modération
// DM — impossible par conception : le serveur ne stocke que du chiffré E2EE
// (boîte aux lettres aveugle) et ne peut ni lire ni qualifier un message privé.
model Report {
  id          String    @id @default(cuid())
  reporterKey String // pubkey du signaleur (preuve signée `report`)
  targetKind  String // "post" | "comment" — jamais "dm" (refusé à l'endpoint)
  targetId    String // id Post (post racine ou commentaire)
  reason      String // spam | harassment | violence | illegal | other
  details     String? // contexte libre (≤ 500 chars)
  status      String    @default("open") // open | actioned | dismissed
  handledAt   DateTime?
  handledBy   String? // identité admin ayant traité (clé API provisoire avant RBAC)
  createdAt   DateTime  @default(now())

  @@unique([reporterKey, targetKind, targetId]) // idempotence : 1 signalement par (signaleur, cible)
  @@index([status, createdAt])
  @@index([targetKind, targetId])
}

// A3 — blocage d'un pair par l'utilisateur. Effets livrés :
//  - fil public : les posts du bloqué disparaissent du fil du bloqueur
//    (préférence d'affichage servie côté serveur — PAS une mesure de
//    confidentialité : le fil est public par nature) ;
//  - DM : les messages du bloqué RESTENT reçus mais MARQUÉS (`fromBlocked`) —
//    décision tranchée à la validation A3 : « reçus, avec option bloquer
//    distincte de masquer ». Le canal DM reste E2EE et aveugle : le serveur
//    n'applique aucun filtrage de contenu privé.
model PeerBlock {
  id         String   @id @default(cuid())
  blockerKey String // celui qui bloque
  blockedKey String // le bloqué
  createdAt  DateTime @default(now())

  @@unique([blockerKey, blockedKey])
  @@index([blockerKey])
}

// A3 — journal d'audit de modération (admin). Toute action y laisse une trace.
// Une PURGE supprime le contenu mais la trace subsiste ici : auteur, extrait
// borné (≤ 280), compteur de signalements clôturés.
model ModerationAction {
  id         String   @id @default(cuid())
  adminKey   String // identité admin (ADMIN_API_KEY — provisoire avant RBAC complet)
  action     String // warn | hide | unhide | suspend | unsuspend | purge
  targetKind String // post | user
  targetId   String // id Post (hide/unhide/purge) ou pubkey User (warn/suspend/unsuspend)
  reason     String?
  reportIds  String? // JSON [] : signalements clôturés par l'action
  meta       String? // JSON : purge → { authorKey, nickname, snippet, repliesPurged, likeCount }
  createdAt  DateTime @default(now())

  @@index([targetKind, targetId])
  @@index([createdAt])
}

// Nœuds passerelle connus (app native / Raspberry Pi qui relayent mesh ↔ internet)
model GatewayNode {
  id         String   @id // senderID hex de la passerelle
  label      String?
  lastSeen   DateTime @updatedAt
  packetsIn  Int      @default(0)
  packetsOut Int      @default(0)
}

// Graphe de confiance (favoris mutuels chez BitChat)
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId]) // abonnés d'une cible (fan-out, profil)
}

// Message privé : le serveur ne stocke QUE du chiffré (AES-GCM sur ECDH P-256)
model DirectMessage {
  id           String    @id @default(cuid())
  senderKey    String // pubkey hex/base64url de l'expéditeur
  recipientKey String // pubkey du destinataire
  iv           String // IV AES-GCM base64
  ciphertext   String // ciphertext AES-GCM base64 (opaque pour le serveur)
  msgId        String? // A1 : identifiant client (uuid) lié par la signature dm2 — null = enveloppe legacy
  seq          Int? // A1 : séquence monotone par (expéditeur, destinataire, époque) — null = enveloppe legacy
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([msgId])

  @@index([senderKey, recipientKey])
  @@index([recipientKey, createdAt])
}
