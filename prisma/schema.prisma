generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Identité = paire de clés locale. Pas d'email, pas de téléphone.
model User {
  id         String   @id @default(cuid())
  pubkey     String   @unique // empreinte publique (ECDSA P-256, base64url) = identité stable
  nickname   String
  bio        String?
  ecdhPub    String? // clé publique ECDH P-256 (base64url) pour le chiffrement des DM
  isBot      Boolean  @default(false)
  botPriv    String? // JWK privée — UNIQUEMENT pour le bot de démonstration
  // A3 (recadrage) — suspension par modération : posts absents du fil public,
  // publication refusée (403) tant que la suspension tient.
  suspendedAt DateTime?
  // ADM Étape 6 — suspension TEMPORAIRE (directive queue UI : 24 h / 7 j) :
  // la suspension est ACTIVE tant que suspendedAt != null ET
  // (suspendedUntil == null OU suspendedUntil > now) — évaluation paresseuse
  // aux points d'application (fil, publication), pas de cron.
  suspendedUntil DateTime?
  // ADM Étape 6 — avertissements de modération visibles dans le profil de
  // l'utilisateur (directive : « notification côté app utilisateur, pas de DM
  // pour rester E2EE ») — écrits par l'action warn, lus par leur titulaire
  // (preuve de possession, /api/moderation/warnings).
  warnings UserWarning[] @relation("userWarnings")
  // ADM Étape 0 (rupture ADMIN_API_KEY) : suspendedBy (String, clé secrète en
  // clair) → suspendedById (FK AdminUser) — identité traçable, jamais de secret.
  suspendedById Int?
  suspendedByAdmin AdminUser? @relation("userSuspendedBy", fields: [suspendedById], references: [id])
  // ADM Étape 9 (four-eyes) — ban DÉFINITIF : écritures bloquées aux points
  // d'application, pas de unban UI (ADMIN-RBAC §5). Posé UNIQUEMENT par
  // l'exécution d'une PendingAction approuvée par un second admin — JAMAIS en
  // direct. (Le « disabledAt » de la directive = bannedAt ici : sémantique
  // identique, nom aligné sur le schéma §5 existant.)
  bannedAt DateTime?
  bannedById Int?
  bannedByAdmin AdminUser? @relation("userBannedBy", fields: [bannedById], references: [id])
  // ── D2 — Sybil phase 0 (directive 2026-11-13) ──────────────────────────
  // Réputation basique : +1 par post > 24 h sans report (sweep paresseux),
  // +2 par like reçu, +1 par follow reçu, −5 par report confirmé (hide/ban).
  // Le score pilote les plafonds de débit quotidiens (dailyLimits §sybil.ts).
  reputationScore Int @default(0)
  // Nombre d'actions de modération confirmées contre ce compte (hide/ban) —
  // signal brut exposé dans le profil, non plafonné.
  flaggedCount Int @default(0)
  // Plafonds de débit quotidiens — compteurs DÉNORMALISÉS (pattern D5) :
  // reset paresseux à minuit UTC (usageDay = "YYYY-MM-DD" UTC auquel ils se
  // rapportent). Aucun cron — évalués aux points d'application.
  postsToday Int @default(0)
  dmsToday   Int @default(0)
  usageDay   String?
  // Anti-rejeu PoW : dernier challenge consommé par cette identité à la
  // création (`${pubkey}|pow|${ts}`). Le rejet global est garanti par la
  // table PowSpent (PK challenge) — ce champ garde la trace locale.
  powChallenge String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  posts     Post[]
  likes     Like[]
  followers Follow[] @relation("following")
  following Follow[] @relation("follower")
}

// Événement public signé côté client (style Nostr kind:1)
model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  geohash   String? // canal géographique (bloc #dr5rsj7 …)
  precision Int? // précision géohash 2..7
  parentId  String? // réponse à un autre post
  parent    Post?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]   @relation("Replies")
  signature String? @unique // signature ECDSA produite sur l'appareil (idempotence : même événement = même post)
  origin    String   @default("web") // web | mesh (arrivé via passerelle BitChat)
  meshHops  Int      @default(0) // sauts mesh traversés (7 − TTL restant)
  // Compteurs dénormalisés (scalabilité D5) : incrémentés atomiquement à l'écriture,
  // les COUNT à chaud disparaissent des lectures de feed.
  likeCount  Int      @default(0)
  replyCount Int      @default(0)
  // A3 (recadrage) — modération du fil public : masqué = absent du fil public,
  // MAIS CONSERVÉ EN DB pour audit (contrairement à la purge qui supprime).
  hiddenAt DateTime?
  // ADM Étape 0 (rupture ADMIN_API_KEY) : hiddenBy (String, clé secrète en
  // clair) → hiddenById (FK AdminUser) — identité traçable, jamais de secret.
  hiddenById Int?
  hiddenByAdmin AdminUser? @relation("postHiddenBy", fields: [hiddenById], references: [id])
  // D2 — sweep de réputation paresseux : +1 au score de l'auteur APRÈS 24 h
  // sans report. Un seul crédit par post (flag), évalué aux points
  // d'application (publication, profil) — jamais de cron.
  reputationRewarded Boolean @default(false)
  createdAt  DateTime @default(now())

  likes Like[]

  @@index([geohash, precision])
  @@index([authorId])
  @@index([parentId])
  @@index([parentId, createdAt]) // scope "replies" : filtre + tri en un seul index
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// D2 — anti-rejeu PoW GLOBAL : chaque challenge PoW consommé
// (pk + ts inclus dans la chaîne) est enregistré ici à la création
// d'identité. Un rejeu (requête capturée rejouée, même nonce) → PK déjà
// présente → 409. Le challenge inclut la pubkey ET le ts : un nonce n'est
// jamais réutilisable pour une autre identité ni une autre tentative (le
// hash change). Lignes ≈ 100 o × créations — purge non nécessaire phase 0.
model PowSpent {
  challenge  String   @id
  consumedAt DateTime @default(now())
}

// Paquets BitChat déjà ingérés par la passerelle VPS (dédup persistante)
model MeshIngest {
  hash      String   @id // SHA-256 hex du paquet brut (F-30 — l'ancien FNV-64 forgeable a été remplacé)
  gatewayId String? // senderID hex du nœud passerelle qui l'a déposé
  type      Int // type de paquet (0x01 announce, 0x02 public, 0x03 DM, 0x04 gossip)
  hops      Int // sauts mesh traversés (TTL_MAX − TTL restant)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A1 (recadrage) — garde anti-rejeu PERSISTANTE : l'empreinte couvre le tuple
// d'identité du DM (expéditeur|destinataire|iv|ciphertext), pas ses octets de
// transport. Un rejeu réemballé (nouveau paquet mesh, nouveaux msgId/seq forgés)
// reste un doublon. TTL 7 j = fenêtre de fraîcheur des preuves (ACTION_MAX_AGE_MS).
model ReplayGuard {
  id        String   @id // SHA-256 hex du tuple canonique (64 chars)
  kind      String   @default("dm") // réservé aux extensions futures (média, groupe)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// A1 — compteur de séquence monotone par (conversation, époque). Seconde
// barrière indépendante de la garde : un message v2 (msgId+seq signés) dont
// la séquence régresse est rejeté même si la garde a été purgée.
model ReplayCounter {
  key          String   @id // SHA-256 hex de `${senderKey}|${recipientKey}|${epoch}`
  senderKey    String
  recipientKey String
  epoch        BigInt // floor(tsNormalisé / REPLAY_EPOCH_MS)
  lastSeq      BigInt
  updatedAt    DateTime @updatedAt

  @@index([senderKey, recipientKey])
  @@index([epoch])
}

// A2 (recadrage) — épinglage de clés de chiffrement (authentification des clés,
// lacune L-3 de la crypto spec). Le serveur enregistre l'état de confiance
// POUR AUDIT ET DÉTECTION DE CHANGEMENT : quand l'ecdhPub servi diverge du
// dernier épinglé, la ligne passe en `changed` (alerte rouge côté client).
// L'épinglage local côté appareil (trust-client.ts) reste la barrière
// indépendante du serveur — contre un serveur pleinement malveillant, la
// comparaison hors-bande du numéro de sécurité reste l'ultime référence.
model TrustedKey {
  id            String    @id @default(cuid())
  ownerKey      String // pubkey ECDSA de l'identité locale (celle qui épingle)
  peerKey       String // pubkey ECDSA du pair (identité stable)
  ecdhPubPinned String // clé ECDH épinglée au moment du contact/vérification
  safetyNumber  String // 60 chiffres calculés sur les clés des DEUX parties
  state         String    @default("unverified") // unverified | verified | changed
  firstSeenAt   DateTime  @default(now())
  verifiedAt    DateTime?
  changedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([ownerKey, peerKey])
  @@index([ownerKey])
}

// A3 (recadrage) — signalement d'un contenu PUBLIC (posts/commentaires) vers la
// file de modération. PÉRIMÈTRE STRICT : fil public uniquement. AUCUNE modération
// DM — impossible par conception : le serveur ne stocke que du chiffré E2EE
// (boîte aux lettres aveugle) et ne peut ni lire ni qualifier un message privé.
model Report {
  id          String    @id @default(cuid())
  reporterKey String // pubkey du signaleur (preuve signée `report`)
  targetKind  String // "post" | "comment" — jamais "dm" (refusé à l'endpoint)
  targetId    String // id Post (post racine ou commentaire)
  reason      String // spam | harassment | violence | illegal | other
  details     String? // contexte libre (≤ 500 chars)
  status      String    @default("open") // open | actioned | dismissed
  handledAt   DateTime?
  // ADM Étape 0 (rupture ADMIN_API_KEY) : handledBy (String, clé secrète en
  // clair) → handledById (FK AdminUser) — identité traçable, jamais de secret.
  handledById Int?
  handledByAdmin AdminUser? @relation("reportHandledBy", fields: [handledById], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([reporterKey, targetKind, targetId]) // idempotence : 1 signalement par (signaleur, cible)
  @@index([status, createdAt])
  @@index([targetKind, targetId])
}

// A3 — blocage d'un pair par l'utilisateur. Effets livrés :
//  - fil public : les posts du bloqué disparaissent du fil du bloqueur
//    (préférence d'affichage servie côté serveur — PAS une mesure de
//    confidentialité : le fil est public par nature) ;
//  - DM : les messages du bloqué RESTENT reçus mais MARQUÉS (`fromBlocked`) —
//    décision tranchée à la validation A3 : « reçus, avec option bloquer
//    distincte de masquer ». Le canal DM reste E2EE et aveugle : le serveur
//    n'applique aucun filtrage de contenu privé.
model PeerBlock {
  id         String   @id @default(cuid())
  blockerKey String // celui qui bloque
  blockedKey String // le bloqué
  createdAt  DateTime @default(now())

  @@unique([blockerKey, blockedKey])
  @@index([blockerKey])
}

// A3 — journal d'audit de modération (admin). Toute action y laisse une trace.
// Une PURGE supprime le contenu mais la trace subsiste ici : auteur, extrait
// borné (≤ 280), compteur de signalements clôturés.
model ModerationAction {
  id         String   @id @default(cuid())
  // ADM Étape 0 (rupture ADMIN_API_KEY) : adminKey (String — clé secrète en
  // clair, SUPPRIMÉE) → adminUserId (FK AdminUser) + actorLabel ("admin-<id>"
  // | "cli" | "legacy"). Aucune clé secrète ni en DB ni en HTTP.
  adminUserId Int?
  adminUser  AdminUser? @relation(fields: [adminUserId], references: [id])
  actorLabel String // "admin-<id>" (session) | "cli" (purge machine) | "legacy" (pré-rupture)
  action     String // warn | hide | unhide | suspend | unsuspend | purge
  targetKind String // post | user
  targetId   String // id Post (hide/unhide/purge) ou pubkey User (warn/suspend/unsuspend)
  reason     String?
  reportIds  String? // JSON [] : signalements clôturés par l'action
  meta       String? // JSON : purge → { authorKey, nickname, snippet, repliesPurged, likeCount }
  createdAt  DateTime @default(now())

  @@index([targetKind, targetId])
  @@index([createdAt])
  @@index([adminUserId])
}

// ADM Étape 6 — avertissement de modération, visible par l'utilisateur AVERTI
// dans son profil (directive queue UI : « notification côté app utilisateur,
// pas de DM pour rester E2EE »). Écrit par l'action warn (même transaction
// que ModerationAction + AdminAudit). `note` = texte de justification de la
// décision (catégorie + texte — format §6 d'ADMIN-RBAC.md) ; aucune donnée
// de DM n'y figure jamais (aucune modération DM, invariant §1.4).
model UserWarning {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("userWarnings", fields: [userId], references: [id])
  // catégorie fermée §6 : SPAM | HARASSMENT | SCAM | CSAM | OTHER
  category    String
  // texte libre de la justification (celui saisi par l'admin, sans le préfixe
  // catégorie — la catégorie a sa colonne) ; ≥ 20 chars imposés à l'endpoint
  note        String
  createdById Int
  createdBy   AdminUser @relation("adminIssuedWarnings", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADM Étape 0 — couche administration (rupture ADMIN_API_KEY)
// ADM Étape 3 — auth (login+TOTP+break-glass) : voir docs/proofs/ADM-step3-4.md
// Audit : docs/proofs/ADM-audit-2026-11-05.md (GO conditionnel, risques R-1/R-2)
// Append-only d'AdminAudit : triggers SQLite (BEFORE UPDATE/DELETE → RAISE)
// posés dans la migration 0004_admin — aucun client (Prisma inclus) ne peut
// les contourner (ils s'exécutent dans le moteur). Garde : check CI
// sqlite_master + schema-guard + relecture super-admin de toute migration
// touchant AdminAudit.
// ─────────────────────────────────────────────────────────────────────────────
model AdminUser {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String? // Argon2id — null pour le pseudo-user system (jamais de login)
  totpSecret    String?
  totpEnrolled  Boolean   @default(false)
  // ADM Étape 3 — anti-rejeu TOTP : dernier compteur de 30 s VALIDÉ avec succès.
  // Un code d'un compteur ≤ à celui-ci est un REJEU → 401 uniforme.
  totpLastCounter Int?
  role          String // system | auditor | support | moderator | super-admin
  createdAt     DateTime  @default(now())
  disabledAt    DateTime?

  sessions          AdminSession[]
  recoveryCodes     AdminRecoveryCode[]
  audits            AdminAudit[]       @relation("auditActor")
  hiddenPosts       Post[]             @relation("postHiddenBy")
  suspendedUsers    User[]             @relation("userSuspendedBy")
  bannedUsers       User[]             @relation("userBannedBy")
  handledReports    Report[]           @relation("reportHandledBy")
  moderationActions ModerationAction[]
  issuedWarnings    UserWarning[]      @relation("adminIssuedWarnings") // Étape 6 : warn → notification profil
  requestedActions  PendingAction[]    @relation("pendingActionCreatedBy") // Étape 9 : four-eyes
  approvedActions   PendingAction[]    @relation("pendingActionApprovedBy") // Étape 9

  @@index([role])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId Int
  // ADM Étape 3 — le cookie porte un token ALÉATOIRE 32 octets ; SEUL SON HASH
  // SHA-256 est stocké ici (jamais le token en clair — directive Étape 3).
  tokenHash   String    @unique
  csrfToken   String // anti-CSRF : exigé en header x-admin-csrf sur toute mutation
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedReason String? // logout | idle-timeout | break-glass | admin-disabled

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

// ADM Étape 3 — break-glass (décision audit §4.2) : 2 codes de secours créés au
// bootstrap, montrés UNE FOIS, stockés HASHÉS Argon2id. Un code utilisé est
// brûlé (usedAt + ip + userAgent) — jamais réutilisable.
model AdminRecoveryCode {
  id            Int       @id @default(autoincrement())
  adminUserId   Int
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])
  codeHash      String // Argon2id PHC — jamais le code en clair
  usedAt        DateTime?
  usedIp        String?
  usedUserAgent String?
  createdAt     DateTime  @default(now())

  @@index([adminUserId])
}

model AdminAudit {
  id            Int      @id @default(autoincrement())
  actorId       Int // FK AdminUser — le « qui » qui manquait à ModerationAction
  actorRole     String // rôle au moment de l'action (copie figée)
  action        String
  targetType    String
  targetId      String
  beforeJson    String? // état avant (JSON en String — Prisma/SQLite sans Json)
  afterJson     String? // état après
  ip            String?
  userAgent     String?
  justification String? // catégorie + texte ≥ 20 chars (décision §4.4 de l'audit)
  createdAt     DateTime @default(now())

  actor AdminUser @relation("auditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// ADM Étape 9 — FOUR-EYES (ADMIN-RBAC §5) : aucune action IRRÉVERSIBLE (ban
// définitif, purge) n'est exécutée par un seul admin. L'intention est posée
// (justification §6 ≥ 20 chars) puis approuvée par un SECOND admin DISTINCT
// (id ET session différents) dans l'heure. Toute la chaîne est audité :
// pendingaction_created / _cancelled / _expired — et l'EXÉCUTION écrit la
// ligne d'audit de la vraie action (ban | purge) dans la MÊME transaction.
// Statuts (tranché 2026-11-06, directive É9 : annulation par le demandeur
// uniquement — le « rejected » de la v1.0 §5 fusionne dans « cancelled ») :
//   pending → executed | cancelled | expired
model PendingAction {
  id          Int      @id @default(autoincrement())
  actionType  String   // ban_user | purge_post
  targetType  String   // user | post — cible réelle, identifiants opératoires
  targetId    String   // pubkey (user) | id du post
  payloadJson String?  // contexte figé à la demande (nickname, snippet…)
  justification String // forme §6 « CATÉGORIE: texte » (≥ 20 chars, serveur)
  status      String   @default("pending") // pending | executed | cancelled | expired
  createdById Int
  createdBy   AdminUser @relation("pendingActionCreatedBy", fields: [createdById], references: [id])
  // L'approbateur doit être un AUTRE admin ET une AUTRE session (anti
  // auto-approbation en 2 onglets) — la double garde est appliquée au code.
  createdBySessionId String
  approvedById Int?
  approvedBy   AdminUser? @relation("pendingActionApprovedBy", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  executedAt  DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime // createdAt + 1 h — évalué PARESSEUSEMENT (approbation → 410)

  @@index([status])
  @@index([createdById])
  @@index([expiresAt])
  @@index([targetType, targetId])
}

// Nœuds passerelle connus (app native / Raspberry Pi qui relayent mesh ↔ internet)
model GatewayNode {
  id         String   @id // senderID hex de la passerelle
  label      String?
  lastSeen   DateTime @updatedAt
  packetsIn  Int      @default(0)
  packetsOut Int      @default(0)
}

// Graphe de confiance (favoris mutuels chez BitChat)
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId]) // abonnés d'une cible (fan-out, profil)
}

// Message privé : le serveur ne stocke QUE du chiffré (AES-GCM sur ECDH P-256)
// D2 — mémoire du crédit de follow : un follow NE crédITE +1 QU'UNE fois
// par paire (abonné, suivi) — la ligne survit à l'unfollow, l'aller-retour
// follow/unfollow ne farme pas le score.
model FollowCredit {
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  @@id([followerId, followingId])
}

model DirectMessage {
  id           String    @id @default(cuid())
  senderKey    String // pubkey hex/base64url de l'expéditeur
  recipientKey String // pubkey du destinataire
  iv           String // IV AES-GCM base64
  ciphertext   String // ciphertext AES-GCM base64 (opaque pour le serveur)
  msgId        String? // A1 : identifiant client (uuid) lié par la signature dm2 — null = enveloppe legacy
  seq          Int? // A1 : séquence monotone par (expéditeur, destinataire, époque) — null = enveloppe legacy
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([msgId])

  @@index([senderKey, recipientKey])
  @@index([recipientKey, createdAt])
}

// B2 — médias chiffrés E2EE (socle B1 activé). Le serveur stocke le
// CIPHERTEXT du client dans un bucket S3-compatible (clés sans identité,
// spec MEDIA-ENVELOPE-SPEC §4.2) et ne tient ici que la correspondance
// mediaId ↔ objectKey + le décompte de quota. Aucun plaintext ne transite.
// cycle de vie : pending (upload-url) → finalized (finalize) | orphan (jamais finalisé).
model Media {
  id          String    @id @default(cuid())
  objectKey   String    @unique // media/<uuid v4> — assertObjectKey (whitelist stricte)
  ownerPubkey String // clé ECDSA du propriétaire (preuve de possession exigée)
  mediaType   String // image/jpeg | image/png | image/webp (whitelist §2)
  sizeBytes   Int // taille du CIPHERTEXT stocké (= Content-Length signé du PUT)
  plainBytes  Int // taille plaintext déclarée par le client (contrôle destinataire)
  sha256      String? // empreinte du ciphertext (contrôle/dédup, déclarée par le client)
  status      String    @default("pending") // pending | finalized
  createdAt   DateTime  @default(now())
  finalizedAt DateTime?

  @@index([ownerPubkey, createdAt]) // quota SUM(sizeBytes) finalized par owner
  @@index([status, createdAt]) // purge des pending orphelins
}

// ─────────────────────────────────────────────────────────────────────────────
// C1 — PUSH NOTIFICATIONS (Web Push VAPID pour la PWA — knock SANS contenu)
// ─────────────────────────────────────────────────────────────────────────────
// Le payload push est un KNOCK : { type, fromLabel } — AUCUN contenu de
// message (E2EE oblige : le serveur ne peut pas lire ce qu'il notifie).
// Upsert idempotent par ENDPOINT (unique) ; disabledAt = purge douce (410
// Gone du push service ou unsubscribe signé) — la ligne reste pour l'audit.
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String // FK logique User.pubkey (identité à clés locales)
  endpoint    String   @unique // URL du push service — évite les doublons
  keysP256dh  String // clé ECDH du navigateur (RFC 8291)
  keysAuth    String // secret d'auth du navigateur (RFC 8291)
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now()) // maj à chaque re-subscribe (upsert)
  disabledAt  DateTime?

  @@index([userId, disabledAt]) // les destinataires actifs d'un knock
  @@index([disabledAt]) // purge des abonnements morts (410)
}

// ───────────────────────── C4 — groupes privés MLS (RFC 9420) ─────────────────────────
// Le serveur est un RELAIS Aveugle : les messages de groupe sont du ciphertext
// MLS opaque (invariant testé : déchiffrer avec une fausse clé → garbage).
// Le serveur tient l'ANNUAIRE (membres, joins/leaves — visibles par définition)
// et les ENVELOPPES de handshake MLS (commits/welcomes — binaire RFC 9420),
// jamais de plaintext.

// Registry de key packages MLS (RFC 9420 §12.4.1.5) : chaque identité publie
// des key packages FRAIS à l'avance ; l'invitant en CONSOMME UN (single-use —
// le HPKE init key ne sert qu'une fois). Pas de contenu sensible (publique).
model MlsKeyPackage {
  id         String   @id @default(cuid())
  userKey    String // pubkey ECDSA de l'app (base64url)
  keyPackage String // key package MLS encodé (b64 wire)
  createdAt  DateTime @default(now())

  @@index([userKey, createdAt])
}

model Group {
  id         String   @id @default(cuid())
  name       String
  mlsGroupId String   @unique // identifiant MLS opaque (hex, 16 octets) — l'ancre d'epoch côté clients
  creatorKey String // pubkey du créateur (admin MVP)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members   GroupMember[]
  messages  GroupMessage[]
  envelopes GroupEnvelope[]

  @@index([creatorKey])
}

model GroupMember {
  id           String    @id @default(cuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userKey      String // pubkey du membre
  mlsLeafIndex Int? // position TreeKEM à l'ajout (diagnostique — l'index réel vit dans l'état client)
  joinedAt     DateTime  @default(now())
  leftAt       DateTime? // forward secrecy : leftAt != null = exclu de l'epoch courante

  @@unique([groupId, userKey])
  @@index([userKey])
}

// Message de groupe : ciphertext MLS opaque (PrivateMessage wire b64).
// AUCUNE lecture serveur possible (MLS est E2EE par construction) — le champ
// mlsEpoch sert au tri client et au diagnostic, pas au déchiffrement.
model GroupMessage {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderKey  String
  mlsEpoch   BigInt // epoch MLS au moment de l'envoi (tri client, diagnostic)
  ciphertext String // PrivateMessage wire (b64) — opaque serveur
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
}

// Enveloppes de HANDSHAKE MLS : commits (diffusion à tous) et welcomes
// (destinataire unique). Relais + persistence offline — le client traite
// DANS L'ORDRE (chaque commit avance l'epoch ; hors ordre = refus ratchet).
model GroupEnvelope {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind      String // "commit" | "welcome"
  targetKey String? // null = diffusion à tous les membres actifs ; sinon welcome pour ce membre
  payload   String // MLSMessage wire (b64) — opaque serveur
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}
