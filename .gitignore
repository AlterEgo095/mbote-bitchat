# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (racine + apps séparées — les artefacts de build ne sont JAMAIS
# trackés : ils salissaient l'arbre à chaque harness admin-e2e, bloquant
# check-merge-clean — vague durcissement)
/.next/
/admin/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …sauf le modèle de variables, à committer (DEPLOY-VPS §10)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# sandbox internals
.zscripts/
tool-results/
download/
*.db

# sandbox data
/db/
*.db

# Expo CNG — projets natifs régénérés par `expo prebuild` (et par la CI)
mobile/android/
mobile/ios/

# sauvegardes locales (ne jamais committer : données chiffrées + clé)
backups/
.backup-key

# D3 : généré par security.yml (npm audit) — bun.lock est la source de vérité
package-lock.json

# GTM 2026-11 — distribution APK : l'APK est téléchargé par deploy-vps.yml
# (release GitHub « latest », asset mbote-latest.apk) — JAMAIS versionné dans
# le dépôt (32-72 MB par build). En local, placer un APK dans ce dossier pour
# tester le bouton de la landing page.
/public/downloads/

# Ops helpers locaux (ne JAMAIS committer : contiennent des credentials)
/tools/
